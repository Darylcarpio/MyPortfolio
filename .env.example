# Database Configuration
# For local development (XAMPP):
DB_HOST=localhost
DB_NAME=db_portfolio
DB_USER=root
DB_PASS=

# For production (InfinityFree/Hosting):
# DB_HOST=localhost
# DB_NAME=your_database_name_with_prefix
# DB_USER=your_username_with_prefix
# DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# Admin Credentials
# CHANGE THESE BEFORE DEPLOYMENT!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToStrongPassword123!
ADMIN_EMAIL=your-email@example.com

# Security Settings
SESSION_LIFETIME=3600
GUEST_SESSION_LIFETIME=86400
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION=7200

# Site Configuration
# For local:
SITE_URL=http://localhost/MyWebsite
# For production:
# SITE_URL=http://yoursite.infinityfreeapp.com
SITE_NAME=Portfolio System

# Environment
# local: development
# production: production
ENVIRONMENT=development
