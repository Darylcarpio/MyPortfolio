# Copy this file to .env and fill with your values. Do NOT commit .env to git.

# Database Configuration (Production)
DB_HOST=localhost
DB_NAME=db_portfolio
DB_USER=your_production_db_user
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# Admin Credentials (Change these for production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToStrongPassword123!
ADMIN_EMAIL=your-email@example.com

# Security Settings
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION=7200

# Site Configuration
SITE_URL=https://yourdomain.com
SITE_NAME=Portfolio System

# Optional: SMTP settings for email (if used)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_ENCRYPTION=tls
